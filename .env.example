# Base URL of Ontotext GraphDB, without a trailing slash.
GRAPH_BACKEND=graphdb
GRAPH_HTTP_TIMEOUT_SECONDS=15
RDF_STORE_PATH=.data/oxigraph
RDF_LABEL_LANGUAGES=en,ANY
GRAPHDB_BASE_URL=http://localhost:7200
GRAPHDB_REPOSITORY=wine
# Create and activate the labeled wine-v2 endpoint before using this value.
GRAPHDB_ENDPOINT_ID=wine-v2
# Comma-separated browser origins allowed to call the public GraphQL API.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
